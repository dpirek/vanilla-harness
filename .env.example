# Copy this file to .env. Values override the active stored configuration.
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-sol
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=

AI_HARNESS_TOOL_LIST_FILES=true
AI_HARNESS_TOOL_READ_FILE=true
AI_HARNESS_TOOL_WRITE_FILE=true
AI_HARNESS_TOOL_SEARCH_FILES=true
AI_HARNESS_TOOL_CURL=false
AI_HARNESS_TOOL_RUN_COMMAND=false
AI_HARNESS_TOOL_CHROME_DEVTOOLS=true

# Comma-separated skill names or ids. An empty value disables all skills.
AI_HARNESS_SKILLS=
AI_HARNESS_INPUT_SOURCE=microphone
AI_HARNESS_MODEL_DISPLAY=engine
AI_HARNESS_WORKFLOW_COMPOSER=true
AI_HARNESS_WORKFLOW_TOOLS=true
AI_HARNESS_WORKFLOW_MCP=true
AI_HARNESS_WORKFLOW_VALIDATION=true

# Optional prompt overrides.
# AI_HARNESS_PROMPT_REFINEMENT=
# AI_HARNESS_AGENT_INSTRUCTIONS=
# AI_HARNESS_WORKSPACE_CONTEXT=
# AI_HARNESS_TOOL_CONTRACT=
# AI_HARNESS_VALIDATION_REMINDER=

# MCP TOML can be supplied inline or loaded from a file relative to this project.
# AI_HARNESS_MCP_CONFIG=
# AI_HARNESS_MCP_CONFIG_PATH=.ai-harness/config.toml

# Optional server defaults.
# PORT=3000
# Takes precedence over the workspace saved in the browser.
# AI_HARNESS_WORKSPACE=/path/to/project
# AI_HARNESS_DATA_DIR=/path/to/runtime-data
